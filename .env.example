# Bitrix24 - Inbound Webhook
BITRIX_WEBHOOK_URL=

# Meta Conversions API
META_PIXEL_ID=
META_CONVERSION_API_TOKEN=

# InfoSimples API
INFOSIMPLES_API_TOKEN=

# OpenAI (chat livre / analise de oficio via LangChain)
OPENAI_API_KEY=

# Webhook RAG externo (opcional - se ausente, cai no fallback OpenAI)
USE_RAG_WEBHOOK=
RAG_WEBHOOK_URL=
RAG_WEBHOOK_API_KEY=
RAG_WEBHOOK_ORIGIN=

# Supabase - observabilidade do chat (sessoes, mensagens, log de integracoes)
# Sem estas vars, a instrumentacao fica em fail-open (nao quebra o chat, apenas nao registra nada)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Hub - link direto para o card do Deal no painel Bitrix (opcional; sem ela, o hub mostra so "#dealId" sem link)
# Ex: https://suaempresa.bitrix24.com.br
NEXT_PUBLIC_BITRIX_PORTAL_URL=

# Bitrix24 OAuth - login do hub em /dashboard
# Crie o app OAuth em: painel Bitrix24 > Configuracoes > Desenvolvedores > Outro > App local (Server-side)
# O redirect_uri cadastrado no app Bitrix precisa ser exatamente HUB_BASE_URL + /api/auth/bitrix/callback
BITRIX_OAUTH_CLIENT_ID=
BITRIX_OAUTH_CLIENT_SECRET=
BITRIX_OAUTH_PORTAL_DOMAIN=       # ex: suaempresa.bitrix24.com.br - restringe login a esse portal
HUB_SESSION_SECRET=                # gerar com `openssl rand -base64 32`
HUB_BASE_URL=                      # ex: https://precatorio-lp.vercel.app
